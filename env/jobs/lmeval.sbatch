#!/bin/bash
#SBATCH --gres=gpu:1
#SBATCH -c 8
#SBATCH --mem=64G
#SBATCH -t 12:00:00
#SBATCH -J lmeval
# One general-capability benchmark for one model. Cluster-neutral.
#   bash env/sb gpu --export=ALL,TAG=srllama,TASK=mmlu env/jobs/lmeval.sbatch
# env: TAG = base | srllama | <name>   TASK = mmlu | mmlu_pro | ifeval | bbh_cot_fewshot
#      protocol variants (eval_general/tasks/, generated by make_variants.py, see docs/14): bbh_cot_fewshot_relaxed | mmlu_pro_cot
#      [LORA=<abs adapter dir>] overrides the adapter; [SHOTS] overrides the few-shot count;
#      [LIMIT=<n>] for a smoke run; [CHAT=1|0] forces the chat template on/off (default: off for mmlu, on otherwise);
#      [LOG_SAMPLES=1] also writes every prompt/response/score, needed to tell a format failure from a knowledge
#      failure on the generate_until tasks. Results -> eval_general/<TAG>/<TASK>/  (override with OUT=<abs dir>)
#      [DEVICE=cpu] runs on a CPU node: only sensible when EVERY request is already in the request cache
#      (same TAG/TASK/CHAT/LIMIT as a finished run) — then no forward pass happens and the job just replays the
#      cached responses through the filters/metrics, e.g. to dump samples with LOG_SAMPLES=1 without a GPU queue:
#        bash env/sb cpu --gres=gpu:0 --mem=80G -t 01:00:00 \
#          --export=ALL,TAG=srllama,TASK=bbh_cot_fewshot,DEVICE=cpu,LOG_SAMPLES=1,OUT=$PWD/eval_general/samples/srllama env/jobs/lmeval.sbatch
# NOTE (2026-09-14): --apply_chat_template is MANDATORY for the GENERATIVE tasks (mmlu_pro / ifeval / bbh). Llama-3.1-8B-Instruct is an instruct model and the
# SR-Agent LoRA was trained on the Llama chat format (agentdojo's `local` renderer builds <|start_header_id|>... itself),
# so evaluating without the template scores both models in a format neither was trained for. Measured cost of getting this
# wrong: base IFEval 61.99 (no template) vs 79.1 published. --fewshot_as_multiturn is the matching setting for the
# few-shot tasks (MMLU-Pro 5-shot, BBH 3-shot) so the shots become real dialogue turns.
# The SR-Agent LoRAs are evaluated WITHOUT the reflection system-prompt append, to match the
# main AgentDojo/RL-Hammer rows. lm-eval sends each task's own prompt; no SRFT prompt is added anywhere.
set -euo pipefail
SRFT_ROOT="${SRFT_ROOT:-$(d="${SLURM_SUBMIT_DIR:-$PWD}"; while [ ! -f "$d/env/select.sh" ] && [ "$d" != / ]; do d=$(dirname "$d"); done; echo "$d")}"
source "$SRFT_ROOT/env/select.sh"
source "$CONDA_SH" && conda activate lmeval
export HF_HUB_OFFLINE=0 TOKENIZERS_PARALLELISM=false PYTHONUNBUFFERED=1
TAG="${TAG:?base|srllama}"; TASK="${TASK:?mmlu|mmlu_pro|ifeval|bbh_cot_fewshot}"
BASE=meta-llama/Llama-3.1-8B-Instruct
case "$TAG" in
  base)    ARGS="pretrained=$BASE,dtype=bfloat16" ;;
  srllama) ARGS="pretrained=$BASE,dtype=bfloat16,peft=${LORA:-$SRFT_ROOT/LLaMA-Factory/saves/llama31-8b/lora/v3base_local_sft_8k_r64_GA4_qkvo_3epoch_5e-6}" ;;
  *)       ARGS="pretrained=$BASE,dtype=bfloat16,peft=${LORA:?LORA required for a custom TAG}" ;;
esac
# MMLU is the documented EXCEPTION: it is scored by loglikelihood over " A"/" B"/" C"/" D", and lm-eval itself warns
# that the template changes loglikelihood/multiple-choice tasks. Measured: base MMLU 68.00 without vs 63.09 with the
# template, because the template pushes the model toward a conversational answer instead of the bare option token.
# Open LLM Leaderboard practice is no template for MMLU. See docs/14 "Chat-template decision". Override with CHAT=1|0.
# few-shot counts follow the Meta-SecAlign paper's table so the published rows are comparable
case "$TASK" in
  mmlu)            NS=${SHOTS:-0} ;;
  mmlu_pro|mmlu_pro_cot)                   NS=${SHOTS:-5} ;;
  ifeval)                                  NS=${SHOTS:-0} ;;
  bbh_cot_fewshot|bbh_cot_fewshot_relaxed) NS=${SHOTS:-3} ;;
  meta_*)                                  NS=${SHOTS:-0} ;;
  *)               NS=${SHOTS:-0} ;;
esac
case "$TASK" in
  mmlu)   CHAT=${CHAT:-0} ;;
  meta_*) CHAT=${CHAT:-0} ;;   # Meta-SecAlign's configs (eval_general/tasks/meta_secalign): prompts come pre-rendered in the
                               # Llama-3.1 chat format from meta-llama/Llama-3.1-8B-Instruct-evals; their runner uses
                               # apply_chat_template=False and num_fewshot=0 (shots are inside the prompts). Same here.
  *)      CHAT=${CHAT:-1} ;;
esac
[ "$CHAT" = 1 ] && TEMPLATE_ARGS="--apply_chat_template --fewshot_as_multiturn" || TEMPLATE_ARGS=""
# the request cache keys on the rendered prompt, so a template flip cannot pick up stale responses;
# the cache is still split by CHAT so the two protocols never share a db file
CHAT_SUFFIX=$([ "$CHAT" = 1 ] && echo "" || echo "_nochat")
OUT="${OUT:-$SRFT_ROOT/eval_general/$TAG/$TASK}"
CACHE="$SRFT_ROOT/eval_general/.cache/$TAG"          # request-level cache: a killed run resumes instead of restarting
mkdir -p "$OUT" "$CACHE"
DEVICE="${DEVICE:-cuda:0}"
echo "cluster=$SRFT_CLUSTER node=$(hostname) gpu=$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null || echo none) device=$DEVICE start=$(date)"
echo "TAG=$TAG TASK=$TASK shots=$NS chat_template=$CHAT out=$OUT args=$ARGS"
lm_eval --model hf --model_args "$ARGS" --tasks "$TASK" --num_fewshot "$NS" --include_path "$SRFT_ROOT/eval_general/tasks" \
  --batch_size auto --device "$DEVICE" --output_path "$OUT" --seed 1234 \
  $TEMPLATE_ARGS \
  --use_cache "$CACHE/$TASK$CHAT_SUFFIX" --cache_requests true \
  ${LOG_SAMPLES:+--log_samples} \
  ${LIMIT:+--limit $LIMIT}
echo "end=$(date)"
